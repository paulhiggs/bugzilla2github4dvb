def github_comment_add(orig_id, new_id):
    """
    Adds a comment to Github #orig_id that Bugzilla Bug is now at #new_id.

    Args:
        orig_id: Original Bugzilla Bug id.
        new_id: Newly assigned GitHub Issue #id.
    """
    print("\tadding a comment to issue #%d on GitHub..." % orig_id)
    comment = new_renumber_comment(orig_id, new_id)
    r = github_post("issues/%d/comments" % orig_id, comment, ["body"])
    if not r:
        print("Error adding new comment to issue #%d on GitHub:\n%s"
              % (orig_id, r.text))
        exit(1)


def github_comment_update(orig_id, new_id):
    """
    Updates a comment on Github #orig_id that Bugzilla Bug is now at #new_id.

    Args:
        orig_id: Original Bugzilla Bug id.
        new_id: Newly assigned GitHub Issue #id.
    """
    print("\tupdating comment on GitHub issue #%d..." % orig_id)
    r = github_get("issues/%d/comments" % orig_id)
    if r:
        comments = r.json()
        for comment in comments:
            bug_id = bug_id_parse(comment["body"])
            if not bug_id:
                continue
            comment_id = int(comment["id"])
            print("\tupdating comment %d on GitHub issue #%d..."
                  % (comment_id, orig_id))
            comment = new_renumber_comment(orig_id, new_id)
            r = github_post("issues/comments/%d" %
                            comment_id, comment, ["body"], "PATCH")
            if not r:
                print("Error updating comment %d on GitHub issue #%d:\n%s"
                      % (comment_id, orig_id, r.text))
                exit(1)
            return
    print("\tno comment found on #%d, adding a new one..." % orig_id)
    github_comment_add(orig_id, new_id)


def github_label_create(label):
    """
    Creates a new label on GitHub.

    Args:
        label: String with new label name.
    """
    print("\tcreating label '%s' on GitHub..." % label)
    r = github_post("labels", {
        "name": label,
        "color": "0"*6,
    }, ["name", "color"])
    if not r:
        print("Error creating label %s: %s" % (label, r.text))
        exit(1)


def github_labels_create(issues):
    """
    Checks if all the labels assigned to all the issues are on GitHub.
    If FORCE_UPDATES flag is set, creates the missing labels.

    Args:
        issues: A dictionary of converted Bugzilla reports.
    """
    # GitHub label names are case-insensitive, so use the first spelling
    # seen for all the issues (i.e. keyword "javadoc", component "Javadoc")
    canonical = {}
    for id in issues:
        issues[id]["labels"] = [canonical.setdefault(label.lower(), label)
                                for label in issues[id]["labels"]]

    for label in sorted(canonical.values()):
        r = github_get("labels/" + quote(label, safe=""))
        if r:
            print("\tlabel '%s' exists on GitHub" % label)
        elif r.status_code != 404:
            print("Error checking label '%s' on GitHub:\n%s" % (label, r.text))
            exit(1)
        else:
            print("WARNING: label '%s' does not exist on GitHub" % label)
            github_label_create(label)


def github_milestones_get():
    """
    Gets all the milestones of the GitHub repository.

    Returns:
        A dictionary of milestone title to milestone number.
    """
    milestones = {}
    page = 1
    while True:
        r = github_get("milestones",
                       {"state": "all", "per_page": 100, "page": page})
        if not r:
            print("Error getting milestones from GitHub:\n%s" % r.text)
            exit(1)
        for milestone in r.json():
            milestones[milestone["title"]] = milestone["number"]
        if 'rel="next"' not in r.headers.get("Link", ""):
            return milestones
        page += 1


def github_milestones_create(issues):
    """
    Checks if all the milestones assigned to all the issues are on GitHub.
    If FORCE_UPDATES flag is set, creates the missing milestones: closed if
    all their issues are closed, open otherwise. Then replaces the milestone
    titles in the issues with the GitHub milestone numbers.

    Args:
        issues: A dictionary of converted Bugzilla reports.
    """
    states = {}
    for id in issues:
        title = issues[id]["milestone"]
        if title is not None:
            states.setdefault(title, set()).add(issues[id]["state"])

    milestones = github_milestones_get()
    for title in sorted(states):
        if title in milestones:
            print("\tmilestone '%s' exists on GitHub" % title)
            continue
        state = "closed" if states[title] == {"closed"} else "open"
        print("WARNING: milestone '%s' does not exist on GitHub" % title)
        print("\tcreating %s milestone '%s' on GitHub..." % (state, title))
        r = github_post("milestones", {
            "title": title,
            "state": state,
            "description": "Bugzilla target milestone",
        }, ["title", "state", "description"])
        if not r:
            print("Error creating milestone %s: %s" % (title, r.text))
            exit(1)
        if FORCE_UPDATES:
            milestones[title] = r.json()["number"]

    for id in issues:
        title = issues[id]["milestone"]
        if title is not None:
            # Without -f the milestones are not created, so there is no number
            issues[id]["milestone"] = milestones.get(title)


def github_branch_get():
    """Returns the default branch of the GitHub repository."""
    r = github_get("/repos/%s/%s" % (GITHUB_OWNER, GITHUB_REPO))
    if not r:
        print("Error getting repository %s/%s from GitHub:\n%s"
              % (GITHUB_OWNER, GITHUB_REPO, r.text))
        exit(1)
    return r.json().get("default_branch") or "main"


def git_blob_sha(data):
    """Returns the git blob SHA-1 of the data, as GitHub reports it."""
    return hashlib.sha1(b"blob %d\0" % len(data) + data).hexdigest()


def github_attachment_upload(attachment):
    """
    Uploads an attachment file to the GitHub repository, unless the same
    file is already there.

    Args:
        attachment: The "upload" dictionary made by attachment2dict().
    """
    with open(attachment["local"], "rb") as f:
        data = f.read()
    url = "contents/" + quote(attachment["path"])
    content = {
        "message": "Add attachment %s of Bugzilla Bug %d"
                   % (attachment["id"], attachment["bug"]),
        "content": base64.b64encode(data).decode("ascii"),
    }

    r = github_get(url)
    if r.status_code == 200 and isinstance(r.json(), dict):
        sha = r.json().get("sha")
        if sha == git_blob_sha(data):
            print("\tattachment %s is up to date on GitHub, skipping..."
                  % attachment["path"])
            return
        content["sha"] = sha
        content["message"] = ("Update attachment %s of Bugzilla Bug %d"
                              % (attachment["id"], attachment["bug"]))
    elif r.status_code != 404:
        print("Error getting %s from GitHub:\n%s"
              % (attachment["path"], r.text))
        exit(1)

    print("\tuploading attachment %s to GitHub..." % attachment["path"])
    r = github_post(url, content, list(content), "PUT")
    if not r:
        print("Error uploading %s to GitHub:\n%s"
              % (attachment["path"], r.text))
        exit(1)


def github_attachments_upload(issues):
    """Uploads the attachment files of all the issues to GitHub."""
    for id in sorted(issues):
        for attachment in issues[id]["attachments"]:
            github_attachment_upload(attachment)


def github_assignees_check(issues):
    """
    Checks if all the users assigned to all the issues are on GitHub.

    Args:
        issues: A dictionary of converted Bugzilla reports.
    """
    a_set = set()
    for id in issues:
        for assignee in issues[id]["assignees"]:
            a_set.add(assignee)

    for assignee in a_set:
        if not github_get("/users/" + assignee):
            print("Error checking user '%s' on GitHub" % assignee)
            exit(1)
        else:
            print("\tassignee '%s' exists on GitHub" % assignee)


########################################################################
## XML parsing and conversion functions
########################################################################


def XML2bug(parent):
    """
    Converts XML nodes to a new Bugzilla bug report dictionary.

    Args:
        parent: A parent XML node to start the conversion.

    Returns:
        A new dictionary containing Bugzilla bug report.
    """
    issue = {}

    if DEBUG:
        print("DEBUG XML:")
    for key in parent:
        if len(key) > 0:
            if DEBUG:
                print("\t> %s" % key.tag)
            val = XML2bug(key)
        else:
            val = key.text
        if key.text:
            if key.tag not in issue:
                issue[key.tag] = val
                if DEBUG:
                    print("\tissue['%s'] = '%s'" % (key.tag, val))
            else:
                if isinstance(issue[key.tag], list):
                    issue[key.tag].append(val)
                    if DEBUG:
                        print("\tissue['%s'].append('%s')" % (key.tag, val))
                else:
                    issue[key.tag] = [issue[key.tag], val]
                    if DEBUG:
                        print("\tissue['%s'] = [issue['%s'], '%s']" %
                              (key.tag, key.tag, val))
        # Parse attributes. Attributes of an element with children (i.e.
        # attachment or long_desc) go into that element's own dictionary,
        # so repeated elements do not overwrite each other's attributes.
        if len(key) > 0:
            target, prefix = val, ""
        else:
            target, prefix = issue, key.tag + "."
        for name, attr in key.items():
            target[prefix + name] = attr
            if DEBUG:
                print("\t['%s%s'] = '%s'" % (prefix, name, attr))

    return issue


def str2list(map, str):
    """Lookups in the map specific string and returns it as a list."""
    if str not in map:
        print("WARNING: unable to convert %s: %s" % (map["__name__"], str))
        # Suppress further reports
        map[str] = []

    return map[str]


def label_name(name):
    """
    Makes a valid GitHub label name: no commas (GitHub rejects them) and
    at most 50 characters.
    """
    name = name.replace(",", ";").strip()
    if len(name) > GITHUB_LABEL_MAX:
        name = name[:GITHUB_LABEL_MAX - 3].rstrip() + "..."
    return name


def value2labels(map, value):
    """
    Lookups in the map specific value and returns it as a list of labels.
    Values not in the map become a label of their own, so that no
    information is lost.
    """
    if value in map:
        return map[value]
    return [label_name(value)]


def text2markdown(text):
    """
    Escapes Bugzilla plain text so GitHub shows it as written instead of
    interpreting it as Markdown or HTML:
      - "<tags>" are shown instead of being hidden as HTML
      - "*", "`" and "~" do not start emphasis, code or strikethrough
      - lines starting with "#", "=" or "-" do not become headings or rules
      - indentation is kept and does not turn text into code blocks
      - "@word" (i.e. XML attributes) does not mention GitHub users
    Bare URLs still become links.
    """
    if not text:
        return ""
    # Keep URLs as they are (escaping would break the links): replace them
    # with placeholders and put them back at the end
    urls = []

    def url_placeholder(match):
        urls.append(match.group(0))
        return "\0%d\0" % (len(urls) - 1)
    text = re.sub(r"(?i)\b(?:https?|ftp)://[^\s<>\"]+", url_placeholder, text)
    text = text.replace("\\", "\\\\")
    text = text.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")
    for char in "*_`~":
        text = text.replace(char, "\\" + char)
    lines = []
    for line in text.split("\n"):
        line = line.rstrip("\r")
        # Keep the indentation without starting a code block
        stripped = line.lstrip(" \t")
        indent = line[:len(line) - len(stripped)].replace("\t", "    ")
        # Headings, setext underlines and horizontal rules
        if stripped[:1] in ("#", "=", "-", "_", "+"):
            stripped = "\\" + stripped
        # Ordered lists would be renumbered by GitHub
        stripped = re.sub(r"^(\d+)([.)])(\s|$)", r"\1\\\2\3", stripped)
        lines.append("&nbsp;" * len(indent) + stripped)
    text = "\n".join(lines)
    # @word in a code span is shown as is and mentions nobody
    text = re.sub(r"(?<![\w.@/\\])@([A-Za-z0-9][\w-]*)", r"`@\1`", text)
    # <URL> ends the link at ">" (a bare URL link would run on to the next
    # space, i.e. into the rest of an XML element)
    return re.sub(r"\0(\d+)\0",
                  lambda match: "<%s>" % urls[int(match.group(1))], text)


def keywords2list(keywords):
    """Splits a Bugzilla comma-separated keywords string into a list."""
    return [k.strip() for k in (keywords or "").split(",") if k.strip()]


def ids2ids(ids):
    """Converts Bugzilla bug report ids to issues #ids."""
    issue = []

    if not ids:
        return ""
    if isinstance(ids, list):
        for id in ids:
            issue.append("#" + id)
    else:
        issue.append("#" + ids)

    return ", ".join(issue)


def email2login(email, name):
    """
    Converts email to a GitHub user login string. Emails mapped in
    EMAIL2LOGIN become @mentions. Other emails are shown by the part before
    the "@" only (with the real name, if Bugzilla has one), so the full
    addresses are not published. No "@" is added to them, because that
    would mention whichever unrelated GitHub user has that login.
    """
    issue = str2list(EMAIL2LOGIN, email)
    if issue:
        return "@" + issue
    user = email.split("@")[0]
    if name and "@" not in name and name != user:
        return "%s (%s)" % (name, user)
    return user


def emails2logins(emails):
    """Converts an email or a list of emails to a string."""
    issue = []
    if isinstance(emails, list):
        for email in emails:
            issue.append(email2login(email, None))
    else:
        issue.append(email2login(emails, None))
    return ", ".join(issue)


def fields_ignore(obj, fields):
    """Ignores (removes) all the fields in the objects."""
    # Ignore some Bugzilla fields
    for field in fields:
        obj.pop(field, None)


def fields_dump(obj):
    """Dumps all the fields in the object."""
    # Make sure we have converted all the fields
    for key, val in obj.items():
        print("\t%s[%d] = %s" % (key, len(val), val))


def attachment_filename(id, filename, content_type):
    """
    Returns the file name an attachment is stored under: the Bugzilla
    attachment id, then the Bugzilla file name. Characters that are not
    allowed in file names are replaced, and an extension is added from the
    content type when the file name has none.
    """
    name = re.sub(r'[\x00-\x1f\\/:*?"<>|]', "_", filename).strip(" .")
    if not name:
        name = "attachment"
    if not os.path.splitext(name)[1]:
        ext = mimetypes.guess_extension(content_type.split(";")[0].strip())
        if ext:
            name += ext
    return "%s-%s" % (id, name)


def link_text(text):
    """Escapes text to be shown inside a Markdown link or image."""
    return text2markdown(text).replace("[", r"\[").replace("]", r"\]")


def bugzilla_bug_url(bug_id):
    """Returns the URL of a bug on Bugzilla."""
    return "%s/show_bug.cgi?id=%d" % (BUGZILLA_URL.rstrip("/"), bug_id)


def bugzilla_attachment_fetch(id, size, path):
    """
    Fetches an attachment file with the Bugzilla REST API into the local
    cache, unless it is already there.

    Args:
        id: Bugzilla attachment id.
        size: Size of the attachment in the XML export, in bytes.
        path: Local file to save the attachment into.

    Returns:
        True if the file is in the local cache, False otherwise.
    """
    if os.path.isfile(path) and os.path.getsize(path) == size:
        return True
    url = "%s/rest/bug/attachment/%s" % (BUGZILLA_URL.rstrip("/"), id)
    headers = {"Accept": "application/json"}
    params = {"include_fields": "data,size"}
    if BUGZILLA_API_KEY:
        # Some Bugzilla servers ignore the X-BUGZILLA-API-KEY header, so the
        # key goes in the query
        params["api_key"] = BUGZILLA_API_KEY
    print("\tfetching attachment %s from Bugzilla..." % id)

    r = None
    for attempt in range(1, GITHUB_RETRIES + 1):
        try:
            r = requests.get(url, headers=headers, params=params,
                             timeout=GITHUB_TIMEOUT)
        except requests.exceptions.RequestException as e:
            r = None
            # The error may contain the URL: do not print the API key
            error = str(e)
            if BUGZILLA_API_KEY:
                error = error.replace(BUGZILLA_API_KEY, "<API key>")
            print("WARNING: fetching attachment %s failed (%s), retrying..."
                  % (id, error))
            time.sleep(min(2 ** attempt, 300))
            continue
        if r.status_code >= 500:
            print("WARNING: fetching attachment %s returned %d, retrying..."
                  % (id, r.status_code))
            time.sleep(min(2 ** attempt, 300))
            continue
        break
    if r is None or r.status_code >= 500:
        print("WARNING: unable to fetch attachment %s from Bugzilla" % id)
        return False

    try:
        answer = r.json()
    except ValueError:
        answer = {}
    if r.status_code == 401 or answer.get("code") in (410, 306):
        # Login required or wrong API key: no attachment can be fetched
        print("Error fetching attachment %s from Bugzilla: %s\n"
              "Please give a valid Bugzilla API key with -k"
              % (id, answer.get("message", r.text)))
        exit(1)
    try:
        data = base64.b64decode(answer["attachments"][str(id)]["data"])
    except (KeyError, TypeError, ValueError):
        print("WARNING: unable to fetch attachment %s from Bugzilla "
              "(HTTP %d): %s" % (id, r.status_code,
                                 answer.get("message", r.text[:200])))
        return False
    if len(data) != size:
        print("WARNING: attachment %s is %d bytes on Bugzilla, but %d bytes "
              "in the XML export" % (id, len(data), size))

    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "wb") as f:
        f.write(data)
    return True


def attachment2dict(bug_id, attach):
    """
    Converts Bugzilla attachment to a dictionary with:
        "text": the text shown in the comment that added the attachment
        "row": the row in the issue's attachments table
        "upload": the file to upload to GitHub, or None
    """
    issue = []

    id = attach.pop("attachid")
    filename = attach.pop("filename")
    content_type = attach.pop("type")
    size = attach.pop("size")
    desc = attach.pop("desc")
    obsolete = attach.pop("isobsolete", "0") == "1"
    patch = attach.pop("ispatch", "0") == "1"

    # Fetch the file from Bugzilla, so it can be uploaded to GitHub
    upload = None
    if BUGZILLA_URL:
        name = attachment_filename(id, filename, content_type)
        repo_path = "%s/%d/%s" % (GITHUB_ATTACHMENTS_DIR, bug_id, name)
        local_path = os.path.join(ATTACHMENTS_CACHE, str(bug_id), name)
        if bugzilla_attachment_fetch(id, int(size), local_path):
            upload = {"bug": bug_id, "id": id, "path": repo_path,
                      "local": local_path,
                      "url": "%s/%s/%s/blob/%s/%s"
                      % (GITHUB_WEB, GITHUB_OWNER, GITHUB_REPO,
                         quote(GITHUB_BRANCH), quote(repo_path))}

    # The file name, linked to the uploaded file when there is one.
    # Obsolete attachments are struck through, as Bugzilla shows them.
    shown = link_text(filename)
    if upload:
        shown = "[%s](%s)" % (shown, upload["url"])
    if obsolete:
        shown = "~~%s~~ **(obsolete)**" % shown

    issue.append("> Attachment %s: %s (%s, %s bytes)"
                 % (id, shown, text2markdown(content_type), size))
    issue.append("> Description:   " + text2markdown(desc))
    issue.append("> Attached by:   %s on %s"
                 % (email2login(attach.pop("attacher", ""),
                                attach.pop("attacher.name", None)),
                    attach.pop("date", "")))
    modified = attach.pop("delta_ts", "")
    if modified:
        issue.append("> Last modified: " + modified)
    if patch:
        issue.append("> Flags:         patch")
    if BUGZILLA_URL:
        issue.append("> Bugzilla:      <%s/attachment.cgi?id=%s>"
                     % (BUGZILLA_URL.rstrip("/"), id))
    if obsolete:
        issue.append("> **This attachment is obsolete.**")
    if upload and content_type.startswith("image/"):
        issue.append(">")
        issue.append("> ![%s](%s?raw=true)" % (link_text(desc), upload["url"]))
    elif not upload:
        if BUGZILLA_URL:
            issue.append("> (the attachment file could not be fetched "
                         "from Bugzilla)")
        else:
            issue.append("> (the attachment contents were not exported "
                         "from Bugzilla)")

    row = "| %s | %s | %s | %s |" % (
        id, shown.replace("|", r"\|"),
        text2markdown(desc.replace("\n", " ")).replace("|", r"\|"),
        text2markdown(content_type).replace("|", r"\|"))

    # Ignore some fields
    fields_ignore(attach, ATTACHMENT_UNUSED_FIELDS)
    # Make sure we have converted all the fields
    if attach:
        print("WARNING: unconverted attachment fields:")
        fields_dump(attach)

    return {"text": "\n".join(issue), "row": row, "upload": upload}


def attachments2dict(bug_id, attachments):
    """Converts Bugzilla attachments to a dictionary by attachment id."""
    if not isinstance(attachments, list):
        attachments = [attachments]
    result = {}
    for attachment in attachments:
        id = attachment["attachid"]
        result[id] = attachment2dict(bug_id, attachment)
    return result


def bugzilladate2githubdate(date):
    result = re.match(
        r'(\d\d\d\d-\d\d-\d\d) (\d\d:\d\d:\d\d) \+(\d\d)(\d\d)', date)
    if not result:
        print("Date %s was not converted!" % date)
        exit(1)
    return "{a}T{b}+{c}:{d}".format(a=result.group(1), b=result.group(2),
                                    c=result.group(3), d=result.group(4))


def current_githubdate():
    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())


# "bug 123" and "bug 123, comment 4", or just "comment #4" (also "comments")
BUG_COMMENT_REF = re.compile(
    r"(?i)\b(bug)\s+#?([0-9]+)"
    r"(?:(,?[ \t]+)(comments?(?:[ \t]+#?|[ \t]*#))([0-9]+))?"
    r"|\b(comments?(?:[ \t]+#?|[ \t]*#))([0-9]+)")


def comment_ref(bug_id, text, number):
    """
    Converts a reference to comment number (as Bugzilla numbers them within
    each bug, the description being comment 0) of a bug into a link to that
    comment's "## Comment <id>" heading.

    Args:
        bug_id: The bug the comment belongs to.
        text: The reference text before the number, i.e. "comment #".
        number: The comment number, as a string.
    """
    commentid = COMMENT_IDS.get(bug_id, {}).get(int(number))
    if commentid and not USE_BETA_API:
        if bug_id == comment_ref.current_bug:
            url = "#comment-%s" % commentid
        else:
            url = "%s/%s/%s/issues/%d#comment-%s" % (
                GITHUB_WEB, GITHUB_OWNER, GITHUB_REPO, bug_id, commentid)
        # GitHub does not turn "#4" into an issue link inside a link
        return "[%s%s](%s)" % (text, number, url)
    # No heading to link to (i.e. beta import API, where the comments are
    # separate): a zero-width space stops "#4" linking to issue #4
    return text.replace("#", "#​") + number


# The bug whose comments are being converted, see comment_ref()
comment_ref.current_bug = 0


def refs2links(text, bug_id, comments=True):
    """
    Converts "bug 123" to "bug #123", which GitHub links to the issue, and
    references to comments to links to their headings (see comment_ref()).

    Args:
        text: Text already converted with text2markdown().
        bug_id: The bug the text belongs to.
        comments: Set False to leave the references to comments as they are,
                  i.e. inside link text.
    """
    def ref(m):
        if m.group(1):
            bug = int(m.group(2))
            result = "%s #%d" % (m.group(1), bug)
            if m.group(4):
                result += m.group(3)
                if comments:
                    result += comment_ref(bug, m.group(4), m.group(5))
                else:
                    result += m.group(4) + m.group(5)
            return result
        if not comments:
            return m.group(0)
        return comment_ref(bug_id, m.group(6), m.group(7))

    comment_ref.current_bug = bug_id
    return BUG_COMMENT_REF.sub(ref, text)


def comment2dict(bug_id, comment, attachments, used_attachments):
    """
    Converts Bugzilla comment to a string (stable APIv3)
    or a dictionary (beta import API).
    """
    body = []

    bug_when = comment.pop("bug_when")
    commentid = comment.pop("commentid")
    number = comment.pop("comment_count", "")
    body.extend([
        # Explicit anchor for the links to this comment, see comment_ref()
        '<a name="comment-%s"></a>' % commentid,
        "",
        "## Comment " + commentid,
        "Date: " + bug_when,
        "From: " + email2login(comment.pop("who"),
                               comment.pop("who.name", None)),
    ])
    if BUGZILLA_URL and number:
        # Bugzilla's own anchor for the comment is its number within the bug
        body.append("Bugzilla: <%s#c%s>" % (bugzilla_bug_url(bug_id), number))
    body.extend([
        "",
        refs2links(text2markdown(comment.pop("thetext", "")), bug_id),
        "",
    ])
    # Convert attachments if any
    # (several comments may reference the same attachment, and an
    # attachment may be missing from the export)
    if "attachid" in comment:
        attachid = comment.pop("attachid")
        used_attachments.add(attachid)
        if attachid not in attachments:
            print("WARNING: attachment %s referenced by comment %s "
                  "is missing from the export" % (attachid, commentid))
        text = "Attachment %s: (not available)" % attachid
        if attachid in attachments:
            text = attachments[attachid]["text"]
        # The attachment text has links: only convert "bug id" to "bug #id"
        body.extend([refs2links(text, bug_id, comments=False), ""])
    body.append("")

    # Ignore some comment fields
    fields_ignore(comment, COMMENT_UNUSED_FIELDS)
    # Make sure we have converted all the fields
    if comment:
        print("WARNING: unconverted comment fields:")
        fields_dump(comment)

    if USE_BETA_API:
        created_at = bugzilladate2githubdate(bug_when)
        # Return a dictionary (beta import API)
        return {"body": "\n".join(body), "created_at": created_at}
    else:
        # Return a string (stable APIv3)
        return "\n".join(body)


def comments2list(bug_id, comments, attachments, used_attachments):
    """
    Converts Bugzilla comments to a list of
    strings (stable APIv3) or dictionaries (beta import API).
    """
    if not isinstance(comments, list):
        comments = [comments]
    return [comment2dict(bug_id, comment, attachments, used_attachments)
            for comment in comments]


def bug2issue(bug):
    """
    Converts all Bugzilla report fields to a new issue dictionary.
    Dumps any unconverted fields, so all the fields must be either converted
    or listed as unused.

    Args:
        bug: A Bugzilla bug report dictionary.

    Returns:
        A new issue dictionary.
    """
    issue = new_issue(bug.pop("bug_id"), False)
    attachments = {}
    used_attachments = set()

    # Convert attachments if any
    if "attachment" in bug:
        attachments = attachments2dict(issue["id"], bug.pop("attachment"))
    issue["attachments"] = [a["upload"] for a in attachments.values()
                            if a["upload"]]
    # Some exports have an empty creation_ts: fall back to the bug_when
    # of the first comment (the bug description)
    if not bug.get("creation_ts"):
        comments = bug.get("long_desc")
        first = comments[0] if isinstance(comments, list) else comments
        if not first or not first.get("bug_when"):
            print("Error: bug %d has no creation_ts and no comments"
                  % issue["id"])
            exit(1)
        bug["creation_ts"] = first["bug_when"]
        print("WARNING: bug %d has no creation_ts, using comment %s date %s"
              % (issue["id"], first.get("commentid"), bug["creation_ts"]))
    # Convert long_desc and attachment to comments
    issue["comments"].extend(comments2list(issue["id"], bug.pop("long_desc"),
                                           attachments, used_attachments))
    # Convert short_desc to title
    issue["title"] = ("%s (" % bug.pop("short_desc") + BUG_SIGNATURE
                      + "%d)" % issue["id"])
    # Convert reporter to user login
    user_login = email2login(bug.pop("reporter"),
                             bug.pop("reporter.name", None))
    # Convert assigned_to to assignees
    issue["assignees"].append(
        email2login(bug.pop("assigned_to"), bug.pop("assigned_to.name", None)))
    # Convert product and component to labels
    product = bug.pop("product")
    component = bug.pop("component")
    issue["labels"].extend(value2labels(PRODUCT2LABELS, product))
    issue["labels"].extend(value2labels(COMPONENT2LABELS, component))
    # Convert bug_status to state
    status = bug.pop("bug_status")
    issue["state"] = str2list(STATUS2STATE, status)
    if USE_BETA_API:
        # Convert creation_ts to created_at
        issue["created_at"] = bugzilladate2githubdate(bug.pop("creation_ts"))
        # Convert delta_ts to updated_at
        issue["updated_at"] = bugzilladate2githubdate(bug.pop("delta_ts"))
        # Convert bug_status to closed
        issue["closed"] = str2list(STATE2CLOSED_BETA, issue["state"])
        if issue["closed"]:
            issue["closed_at"] = issue["updated_at"]
    else:
        # Convert creation_ts to created_at
        issue["created_at"] = bug.pop("creation_ts")
        # Convert delta_ts to updated_at
        issue["updated_at"] = bug.pop("delta_ts")
        issue["user.login"] = user_login

    # Convert priority to labels
    priority = bug.pop("priority")
    issue["labels"].extend(value2labels(PRIORITY2LABELS, priority))
    # Convert severity to labels
    severity = bug.pop("bug_severity")
    issue["labels"].extend(str2list(SEVERITY2LABELS, severity))
    # Convert resolution to labels
    resolution = bug.pop("resolution", "")
    if resolution:
        issue["labels"].extend(value2labels(RESOLUTION2LABELS, resolution))
    # Convert keywords to labels
    keywords = keywords2list(bug.pop("keywords", ""))
    for keyword in keywords:
        issue["labels"].extend(value2labels(KEYWORD2LABELS, keyword))

    # Create the bug description
    body = []
    body.extend([
        "# " + BUG_SIGNATURE + "%d" % issue["id"],
        "Date: " + issue["created_at"],
        "From: " + user_login,
        "To:   " + ", ".join(issue["assignees"]),
    ])
    if BUGZILLA_URL:
        body.append("Bugzilla: <%s>" % bugzilla_bug_url(issue["id"]))
    if "cc" in bug:
        body.append("CC:   " + emails2logins(bug.pop("cc")))
    # Extra information
    body.append("")
    if "dup_id" in bug:
        body.append("Duplicates:   " + ids2ids(bug.pop("dup_id")))
    if "dependson" in bug:
        body.append("Depends on:   " + ids2ids(bug.pop("dependson")))
    if "blocked" in bug:
        body.append("Blocker for:  " + ids2ids(bug.pop("blocked")))
    if "see_also" in bug:
        if isinstance(bug["see_also"], list):
            for see_also in bug.pop("see_also"):
                body.append("See also:     " + see_also)
        else:
            body.append("See also:     " + bug.pop("see_also"))
    body.append("Last updated: " + issue["updated_at"])
    body.append("")

    # Convert target_milestone to milestone. The title is replaced with
    # the GitHub milestone number by github_milestones_create().
    target_milestone = bug.pop("target_milestone", "")
    if target_milestone not in BUGZILLA_EMPTY_VALUES:
        issue["milestone"] = target_milestone

    # All the other Bugzilla fields, so no information is lost
    fields = [
        ("Product", product),
        ("Component", component),
        ("Version", bug.pop("version", "")),
        ("Target milestone", target_milestone),
        ("Classification", bug.pop("classification", "")),
        ("Status", " ".join(v for v in (status, resolution) if v)),
        ("Severity", severity),
        ("Priority", priority),
        ("Keywords", ", ".join(keywords)),
        ("URL", bug.pop("bug_file_loc", "")),
        ("Whiteboard", bug.pop("status_whiteboard", "")),
        ("Deadline", bug.pop("deadline", "")),
        ("Hardware", bug.pop("rep_platform", "")),
        ("OS", bug.pop("op_sys", "")),
        ("Estimated time", bug.pop("estimated_time", "")),
        ("Remaining time", bug.pop("remaining_time", "")),
        ("Actual time", bug.pop("actual_time", "")),
    ]
    groups = bug.pop("group", [])
    bug.pop("group.id", None)
    if not isinstance(groups, list):
        groups = [groups]
    fields.append(("Restricted to groups", ", ".join(groups)))
    if "flag.name" in bug:
        fields.append(("Flag", "%s%s (set by %s)" % (
            bug.pop("flag.name"), bug.pop("flag.status", ""),
            email2login(bug.pop("flag.setter", ""), None))))
        fields_ignore(bug, ["flag.id", "flag.type_id"])
    body.append("| Bugzilla field | Value |")
    body.append("| --- | --- |")
    for name, value in fields:
        if value not in BUGZILLA_EMPTY_VALUES:
            # Escape characters that would break the markdown table
            value = text2markdown(value.replace("\n", " ")).replace("|", r"\|")
            body.append("| %s | %s |" % (name, value))
    body.append("")
    # All the attachments, so they can be found without reading every comment
    if attachments:
        body.append("| Attachment | File | Description | Type |")
        body.append("| --- | --- | --- | --- |")
        for id in sorted(attachments, key=int):
            body.append(attachments[id]["row"])
        body.append("")

    # Put everything together
    if USE_BETA_API:
        issue["body"] += "\n".join(body)
    else:
        issue["body"] += "\n".join(body) + "\n\n" + \
            "\n".join(issue["comments"])
    issue["assignees"] = [a[1:] for a in issue["assignees"] if a[0] == "@"]
    # Get unique labels (GitHub label names are case-insensitive)
    labels = {}
    for label in issue["labels"]:
        labels.setdefault(label.lower(), label)
    issue["labels"] = list(labels.values())

    # Ignore some bug fields
    fields_ignore(bug, BUG_UNUSED_FIELDS)
    # Make sure we have converted all the fields
    if bug:
        print("WARNING: unconverted bug fields:")
        fields_dump(bug)
    # Make sure we have converted all the attachments
    unused = {k: v for k, v in attachments.items()
              if k not in used_attachments}
    if unused:
        print("WARNING: unused attachments:")
        fields_dump(unused)

    return issue


def bugs2dict(xml_root):
    """
    Converts XML root node to a dictionary of issues.

    Args:
        xml_root: The root XML element.

    Returns:
        A new dictionary of converted Bugzilla reports.
    """
    # Comment numbers of all the bugs first, as comments may refer to the
    # comments of other bugs
    COMMENT_IDS.clear()
    for xml_bug in xml_root.iter("bug"):
        ids = COMMENT_IDS.setdefault(int(xml_bug.findtext("bug_id")), {})
        for number, xml_comment in enumerate(xml_bug.iter("long_desc")):
            # Bugzilla 5 exports the comment number as comment_count
            count = xml_comment.findtext("comment_count")
            if count and count.isdigit():
                number = int(count)
            ids[number] = xml_comment.findtext("commentid")

    issues = {}
    for xml_bug in xml_root.iter("bug"):
        bug = XML2bug(xml_bug)
        issue = bug2issue(bug)
        # Check for duplicates
        id = issue["id"]
        if id in issues:
            print("Error checking duplicates: #%d is duplicated in '%s'"
                  % (id, XML_FILE))
        issues[id] = issue

    return issues


