def github_issues_add(issues):
    """
    Adds dictionary of converted issues to GitHub Issue tracker,
    i.e. this is the main script logic.

    Args:
        issues: Dictionary of issues converted from Bugzilla export.
    """
    id = 0
    while issues:
        id += 1
        print("Checking GitHub issue #%d..." % id)
        github_issue = github_issue_get(id)
        if github_issue:
            bug_id = bug_id_parse(github_issue["body"])
            if bug_id > 0:
                issue = issues.pop(bug_id, None)
                if issue and github_issue_unchanged(github_issue, issue):
                    # Do not use up GitHub's rate limit on a resumed run
                    print("\tissue #%d is the Bug %d, up to date, skipping..."
                          % (id, bug_id))
                    continue
                print("\tissue #%d is the Bug %d, updating..." % (id, bug_id))
                github_issue_update(id, issue)
            elif bug_id == 0:
                if (github_issue["state"] == "closed"
                        and github_issue["title"] == DELETED_BUG_SIGNATURE):
                    print("\tissue #%d is a deleted Bugzilla Bug, up to date, "
                          "skipping..." % id)
                    continue
                print("\tissue #%d is a deleted Bugzilla Bug, updating..." % id)
                issue = new_issue(id, True)
                github_issue_update(id, issue)
            else:
                print("\tissue #%d already exists on GitHub, skipping..." % id)
                continue
        else:
            # Try to add Bug id to the same #id
            issue = issues.pop(id, None)
            if issue:
                print("\tadding Bugzilla Bug %d as GitHub issue #%d..."
                      % (id, id))
            else:
                # Or just add a next issue
                first_id = sorted(issues)[0]
                if first_id > id:
                    # We are not there yet, just add a dummy
                    print("\tadding a dummy (deleted) bug as #%d..." % id)
                    issue = new_issue(id, True)
                else:
                    # Otherwise, just add postponed issue
                    print("\trenumbering Bugzilla Bug %d to GitHub issue #%d..."
                          % (first_id, id))
                    issue = issues.pop(first_id)
            # Note: appending an issue does not guarantee it will become #id
            github_issue_add(id, issue)


def github_issue_unchanged(github_issue, issue):
    """
    Checks whether an issue on GitHub already matches the converted Bugzilla
    Bug, so it does not need to be updated.

    Args:
        github_issue: A json-encoded issue from GitHub.
        issue: Converted Bugzilla Bug.
    """
    milestone = github_issue.get("milestone") or {}
    return (github_issue["title"] == issue["title"]
            and (github_issue["body"] or "").replace("\r\n", "\n")
            == issue["body"]
            and github_issue["state"] == issue["state"]
            and sorted(l["name"].lower() for l in github_issue["labels"])
            == sorted(l.lower() for l in issue["labels"])
            and sorted(a["login"] for a in github_issue["assignees"])
            == sorted(issue["assignees"])
            and milestone.get("number") == issue["milestone"])


def github_issue_get(id):
    """
    Gets issue #id from GitHub.

    Args:
        id: GitHub #id to get.

    Returns:
        A json-encoded issue or None if issue #id does not exist on GitHub.
    """
    req = github_get("issues/%d" % id)
    if req.status_code in (404, 410):
        return None
    if not req:
        print("Error getting issue #%d from GitHub:\n%s" % (id, req.text))
        exit(1)
    return req.json()


def github_issue_update(id, issue):
    """
    Updates issue #id on GitHub.

    Args:
        id: GitHub #id to update.
        issue: Converted Bugzilla Bug to be updated.

    Returns:
        A response object on success or exits with error otherwise.
    """
    print("\tupdating issue #%d on GitHub..." % id)
    if not issue:
        print("Error updating #%d: Bugzilla Bug is missing" % id)
        exit(1)

    # TODO: There is no update functionality in beta API,
    # so we use stable API to update the issue
    r = github_post("issues/%d" % id, issue,
                    ["title", "body", "state", "labels", "assignees",
                     "milestone"], "PATCH")
    if not r:
        print("Error updating issue #%d on GitHub:\n%s" % (id, r.text))
        exit(1)

    orig_id = issue["id"]
    if id != orig_id:
        github_comment_update(orig_id, id)


def github_issue_add_stable(id, issue):
    # Note: this still does not guarantee the new issue will be added as #id
    r = github_post("issues", issue,
                    ["title", "body", "labels", "assignees", "milestone"])
    if not r:
        print("Error adding a new issue on GitHub:\n%s" % r.text)
        exit(1)

    if FORCE_UPDATES:
        # Make sure the issue is added as #id
        github_issue = github_issue_get(id)
        if not github_issue:
            print("Error adding issue: issue %d does not exist" % id)
            exit(1)
        bug_id = bug_id_parse(github_issue["body"])
        if bug_id and bug_id != issue["id"]:
            print("Error adding issue: issue %d is not %d"
                  % (bug_id, issue["id"]))
            exit(1)

    # Default state for the newly created issues is open, so we need to update
    # the state and the renumbering comment.
    github_issue_update(id, issue)

    return r


def github_issue_add_beta(id, issue):
    # Note: this still does not guarantee the new issue will be added as #id

    # Convert issue to beta import API
    comments = issue.pop("comments", [])
    attachments = issue.pop("attachments", [])
    assignees = issue.pop("assignees", [])
    if len(assignees) > 0:
        issue["assignee"] = assignees[0]
    old_id = issue.pop("id", 0)
    milestone = issue.pop("milestone", None)
    if milestone is not None:
        issue["milestone"] = milestone
    issue_comments = {"issue": issue, "comments": comments}

    r = github_post("import/issues", issue_comments, ["issue", "comments"])
    if not r:
        print("Error importing a new issue on GitHub:\n%s" % r.text)
        exit(1)

    # Convert issue back to stable API
    issue["id"] = old_id
    issue["milestone"] = milestone
    issue["assignees"] = assignees
    issue["attachments"] = attachments

    if FORCE_UPDATES:
        # Wait until the issue is imported
        u = r.json()["url"]
        wait = 1
        r = False
        while not r or r.json()["status"] == "pending":
            time.sleep(wait)
            wait = 2 * wait
            r = github_get(u)
        if not r.json()["status"] == "imported":
            print("Error importing issue on GitHub:\n%s" % r.text)
            exit(1)

        # The issue_url field of the answer should be of the form
        # .../ISSUE_NUMBER so it's easy to get the issue number,
        # to check that it is what was expected.
        result = re.match("https://api.github.com/repos/" + GITHUB_OWNER +
                          "/" + GITHUB_REPO + r"/issues/(\d+)",
                          r.json()["issue_url"])
        if not result:
            print("Error while parsing issue number:\n%s" %
                  r.json()["issue_url"])
            exit(1)
        issue_number = int(result.group(1))
        if issue_number != id:
            print("Error adding issue: issue %d is not %d"
                  % (issue_number, id))
            exit(1)

    # Need to update the renumbering comment
    github_issue_update(id, issue)

    return r


def github_issue_add(id, issue):
    """
    Adds issue #id to GitHub. GitHub does not allow direct issue id
    assignment, so prior to call this function, a previous issue (i.e. issue
    #id-1) MUST exist on GitHub and the issue to add (i.e. issue #id) MUST NOT
    exist on GitHub.

    Still, if someone in parallel adds an issue on GitHub, there is
    no guarantee the newly added issue will be added as #id.

    Please make sure no one else is modifying the issues at the same time
    you run this script!

    Args:
        is: GitHub #id to be added.
            Note: GitHub does not allow to add a specific #id, so this #id
                  MUST not exist on GitHub
        issue: Converted Bugzilla Bug to be added.
    """
    print("\tadding a new issue #%d on GitHub..." % id)

    if USE_BETA_API:
        return github_issue_add_beta(id, issue)
    else:
        return github_issue_add_stable(id, issue)


def github_url(url):
    """
    Converts a short URL to a full GitHub API URL:
         '/' -- the request is sent to main GitHub API URL + url string
         'http://' or 'https://' -- the request is sent to the specified url
         otherwise the request is sent to:
            GitHub API URL + /repos/ + GitHub Owner + GitHub Repo + url
    """
    if url[0] == "/":
        return GITHUB_API + url
    if url.startswith("https://") or url.startswith("http://"):
        return url
    return "%s/repos/%s/%s/%s" % (GITHUB_API, GITHUB_OWNER, GITHUB_REPO, url)


def github_headers():
    """
    Returns the request headers. The token always goes in the Authorization
    header: GitHub no longer accepts it as an access_token query parameter.
    """
    return {
        "Accept": GITHUB_BETA_APP if USE_BETA_API
        else "application/vnd.github+json",
        "Authorization": "token " + GITHUB_TOKEN,
    }


def github_request(method, url, data=None, params=None):
    """
    Sends a request to GitHub, retrying on network errors, server errors
    and rate limits.

    Args:
        method: HTTP method, i.e. "GET", "POST" or "PATCH".
        url: A short or full URL, see github_url().
        data: An optional JSON string to send.
        params: An optional dictionary to be sent in the query.

    Returns:
        A response object. Exits if GitHub still fails after all retries.
    """
    u = github_url(url)
    if DEBUG:
        # It's insecure to dump the headers with the token
        print("DEBUG %s: %s" % (method, u))
        if data:
            print("DEBUG DATA: " + data)

    # Rate limits only mean "slow down", so waiting for them does not count
    # as a failed attempt: the script waits as long as GitHub needs
    attempt = 0
    limited = 0
    while attempt < GITHUB_RETRIES:
        try:
            r = requests.request(method, u, params=params,
                                 headers=github_headers(), data=data,
                                 timeout=GITHUB_TIMEOUT)
        except requests.exceptions.RequestException as e:
            attempt += 1
            wait = min(2 ** attempt, 300)
            print("WARNING: %s %s failed (%s), retrying in %ds..."
                  % (method, u, e, wait))
            time.sleep(wait)
            continue

        if r.status_code in (403, 429) and github_rate_limited(r):
            limited += 1
            wait = github_rate_limit_wait(r, limited)
            print("WARNING: GitHub rate limit reached, waiting %ds..." % wait)
            time.sleep(wait)
            continue
        if r.status_code >= 500:
            attempt += 1
            wait = min(2 ** attempt, 300)
            print("WARNING: %s %s returned %d, retrying in %ds..."
                  % (method, u, r.status_code, wait))
            time.sleep(wait)
            continue

        if method != "GET":
            # GitHub asks clients to pause between content-creating requests
            time.sleep(GITHUB_WRITE_DELAY)
        return r

    print("Error: %s %s still failing after %d attempts"
          % (method, u, GITHUB_RETRIES))
    exit(1)


def github_rate_limited(r):
    """Checks whether a 403 or 429 response is a rate limit."""
    return (r.status_code == 429
            or "Retry-After" in r.headers
            or r.headers.get("X-RateLimit-Remaining") == "0"
            or "rate limit" in r.text.lower())


def github_rate_limit_wait(r, attempt):
    """Returns how many seconds to wait after a rate limit response."""
    if "Retry-After" in r.headers:
        return int(r.headers["Retry-After"]) + 1
    if r.headers.get("X-RateLimit-Remaining") == "0":
        reset = int(r.headers.get("X-RateLimit-Reset", "0"))
        return max(reset - int(time.time()), 0) + 5
    # Secondary rate limit with no hint: wait at least a minute, then longer
    # each time, up to 15 minutes
    return min(60 * attempt, 900)


def github_get(url, params=None):
    """
    Sends GET request to GitHub or a specified URL (see github_url()).

    Returns:
        A response object.
    """
    return github_request("GET", url, params=params)


def github_post(url, dict={}, fields=[], method="POST"):
    """
    Sends POST (or PATCH) request to a specified URL (see github_url()).
    If global flag FORCE_UPDATES is not set, the function prints a warning
    and just returns True.

    Args:
        url: A string with an URL to post.
        dict: An optional dictionary to be posted.
        fields: An optional list of fields to send from the dictionary.
        method: "POST" to create, "PATCH" to update.

    Returns:
        A response object. If the global flag FORCE_UPDATES is not set, always
        returns True.
    """
    d = {}
    # Copy fields into the data
    for field in fields:
        if field not in dict:
            print("Error posting field '%s' to %s" % (field, url))
            exit(1)
        d[field] = dict[field]
    data = json.dumps(d)

    if FORCE_UPDATES:
        return github_request(method, url, data=data)
    else:
        if DEBUG:
            print("DEBUG %s (skipped): %s" % (method, github_url(url)))
            print("DEBUG DATA: " + data)
        if not github_post.POST_WARNING_PRINTED:
            print("Skipping POST... (use -f to force updates)")
            github_post.POST_WARNING_PRINTED = True
        return True


# A flag if the post warning has been printed
